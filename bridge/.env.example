# Copy to bridge/.env and fill in. Never commit the real file.

# REQUIRED. Shared secret the app sends as the X-API-Key header (and in the first
# WebSocket message — never in a URL). The bridge can open and close REAL positions,
# so it REFUSES TO START without it. Minimum 16 characters, 24+ if you expose the
# bridge to a network. Must equal BRIDGE_API_KEY in the Flutter app's .env. Make one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_API_KEY=

# Where the bridge listens. Default 127.0.0.1 = only programs on THIS machine can
# reach it (the safe choice when MT5, the bridge and the app share one PC).
# 0.0.0.0 exposes it to your network — only for a phone/tablet on your LAN, and
# then prefer a VPN (Tailscale / WireGuard) over opening the port. Never forward
# this port to the internet.
BRIDGE_HOST=127.0.0.1

# Extra browser origins allowed to call the bridge (comma separated). Only needed
# for a Flutter *web* build served from another address; localhost is always allowed.
BRIDGE_CORS_ORIGINS=

# Telegram alerts. The bot token lives HERE ONLY — the app sends alerts through the
# bridge (POST /notify), so the token is never bundled inside the app.
# Create a bot with @BotFather, message it once, then open
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Remote control (/status /pause /resume /closeall /stop) obeys ONLY these Telegram
# user ids. Leave empty when TELEGRAM_CHAT_ID is your own private chat (it is then the
# only allowed user). For a GROUP chat id (negative number) you must list the user ids
# allowed to command, comma separated; find yours by messaging @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# Optional: broker server timezone vs UTC, in hours (e.g. 3 for GMT+3).
# Leave empty to auto-detect from live ticks (needs the market to be open).
MT5_SERVER_UTC_OFFSET_HOURS=

# Symbol polled from startup for offset detection.
BRIDGE_SYMBOL=XAUUSD

# Server-side AI commentary (keeps the key out of the APK).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: where the bridge keeps strategy_config.json, its audit log and
# config backups (default: bridge/data/, git-ignored).
BRIDGE_DATA_DIR=
