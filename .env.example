# Copy this file to `.env` (same folder) and fill in your own values.
# Never commit the real .env file.

# Set to "true" to run entirely on simulated candles (no MT5/AI/Telegram
# calls) — great for trying the app out. Set to "false" for live trading.
USE_MOCK_DATA=true

# URL of the MT5 bridge server (see /bridge/mt5_bridge_server.py). Leave
# empty to use the built-in platform-aware default (see AppConfig.
# bridgeBaseUrl) — set explicitly if a real Android device needs your
# PC's LAN IP.
BRIDGE_BASE_URL=

# Must equal BRIDGE_API_KEY in bridge/.env (leave both empty on a trusted LAN).
BRIDGE_API_KEY=

# Only needed in bridge mode, and only if your broker doesn't call gold
# plain "XAUUSD" (check MT5's Market Watch — e.g. "XAUUSD.m", "GOLD#",
# "XAUUSD..."). Leave empty to use "XAUUSD" as-is.
MT5_SYMBOL=

# Set "true" on a device that can never reach the bridge PC (different
# network, e.g. a second phone on mobile data) — skips the bridge/tick
# stream entirely instead of burning ~10s per poll on a doomed timeout.
DISABLE_MT5_BRIDGE=false

# Yahoo GC=F is futures (priced differently from spot). By default the app
# pauses signals while Yahoo is the only reachable feed; "true" overrides.
ALLOW_FUTURES_FALLBACK_SIGNALS=false

# Optional free API key from https://twelvedata.com (free tier: 800
# requests/day, 8 requests/minute) — used as the SECOND failover tier
# when the MT5 bridge is unreachable, ahead of the Yahoo Finance
# fallback. Leave empty to skip straight to Yahoo Finance.
TWELVE_DATA_API_KEY=

# Fallback only — prefer ANTHROPIC_API_KEY in bridge/.env. Anything here is
# packaged inside the APK and can be extracted from it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: Telegram alert delivery.
# Create a bot via @BotFather, then message it once and check
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
