# Copy to bridge/.env and fill in. Never commit the real file.

# Shared secret the app must send (X-API-Key header / ?api_key= on the
# WebSocket). Must equal BRIDGE_API_KEY in the Flutter app's .env.
# REQUIRED before exposing this server beyond your LAN.
BRIDGE_API_KEY=

# Optional: broker server timezone vs UTC, in hours (e.g. 3 for GMT+3).
# Leave empty to auto-detect from live ticks (needs the market to be open).
MT5_SERVER_UTC_OFFSET_HOURS=

# Symbol polled from startup for offset detection.
BRIDGE_SYMBOL=XAUUSD

# Server-side AI commentary (keeps the key out of the APK).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
