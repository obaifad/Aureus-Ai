# Copy this file to `.env` (same folder) and fill in your own values.
# Never commit the real .env file.

# Set to "true" to run entirely on simulated candles (no MT5/AI/Telegram
# calls) — great for trying the app out. Set to "false" for live trading.
USE_MOCK_DATA=true

# URL of the MT5 bridge server (see /bridge/mt5_bridge_server.py). Leave
# empty to use the built-in platform-aware default (see AppConfig.
# bridgeBaseUrl) — set explicitly if a real Android device needs your
# PC's LAN IP.
BRIDGE_BASE_URL=

# Must equal BRIDGE_API_KEY in bridge/.env (leave both empty on a trusted LAN).
BRIDGE_API_KEY=

# Only needed in bridge mode, and only if your broker doesn't call gold
# plain "XAUUSD" (check MT5's Market Watch — e.g. "XAUUSD.m", "GOLD#",
# "XAUUSD..."). Leave empty to use "XAUUSD" as-is.
MT5_SYMBOL=

# Set "true" on a device that can never reach the bridge PC (different
# network, e.g. a second phone on mobile data) — skips the bridge/tick
# stream entirely instead of burning ~10s per poll on a doomed timeout.
DISABLE_MT5_BRIDGE=false

# Yahoo GC=F is futures (priced differently from spot). By default the app
# pauses signals while Yahoo is the only reachable feed; "true" overrides.
ALLOW_FUTURES_FALLBACK_SIGNALS=false

# Optional free API key from https://twelvedata.com (free tier: 800
# requests/day, 8 requests/minute) — used as the SECOND failover tier
# when the MT5 bridge is unreachable, ahead of the Yahoo Finance
# fallback. Leave empty to skip straight to Yahoo Finance.
TWELVE_DATA_API_KEY=

# Fallback only — prefer ANTHROPIC_API_KEY in bridge/.env. Anything here is
# packaged inside the APK and can be extracted from it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: Telegram alert delivery.
# Create a bot via @BotFather, then message it once and check
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Opening Range Breakout strategy (orb_engine.dart) ---------------------
# One of two fifth/fourth strategy tiers that need a 5M candle fetch — off
# by default. Enabling either adds a real 5M candle fetch every poll (every
# other tier only ever reads 15M/1H/4H); enabling BOTH shares that one
# fetch rather than doubling it, so only turn either on if you want the
# extra TwelveData/Yahoo request volume.
USE_ORB=false
ORB_LONDON_ENABLED=true
ORB_NEWYORK_ENABLED=true
# Leave both at 0 to use the dynamic default (SL behind the OPPOSITE side
# of the Opening Range, TP at the standard Risk:Reward ratio). Set either
# to switch that one side to a fixed pip distance from Entry instead.
ORB_STOP_LOSS_PIPS=0
ORB_TAKE_PROFIT_PIPS=0
# The Opening Range window itself is AppConfig.orbRangeMinutes — narrowed
# from 30 to 15 minutes on 2026-09-24 (3 x 5M candles). Every other ORB
# condition is unchanged (closed 5M candles only, a CLOSE beyond the range
# to break it, a mandatory retest, one trade per session per day).
# A formed range also EXPIRES 2 hours after its window closes
# (AppConfig.orbMaxHoursAfterRange): both the breakout AND its retest must
# complete inside that window, so no entry can fire off a range hours after
# the session opened.

# --- Break-Even stop (RETIRED 2026-09-24) ----------------------------------
# While true, a trade reaching 1R moved its Stop Loss to Entry. Now false:
# the Stop Loss NEVER moves once placed, so every trade resolves as a clean
# binary — the original Stop Loss, or the Take Profit. Set to true only to
# restore the old behaviour for comparison.
BREAK_EVEN_ENABLED=false

# --- DXY Correlation Filter (dxy_filter_service.dart) -----------------------
# A confirmation-only filter applied to EVERY strategy's setups, never an
# independent trigger — off by default. When on: a XAUUSD BUY is only
# allowed while DXY itself is bearish (weak dollar), a SELL only while DXY
# is bullish (strong dollar); any failure to read DXY (feed down, no
# symbol, unclear trend) bypasses the filter rather than blocking the trade.
USE_DXY_FILTER=false
# Leave empty to auto-detect (bridge Market Watch search for "DXY"/"USDX"/
# "DOLLAR", falling back to Yahoo Finance's public "DX-Y.NYB" ticker when
# the bridge is unavailable or has no match). Set explicitly to override.
DXY_SYMBOL_NAME=

# --- Breakout/Momentum strategy (breakout_momentum_engine.dart) ------------
# A fifth, fully independent strategy tier — off by default (see the ORB
# note above re: the shared 5M candle fetch). Decision chain:
#   Important Level -> Breakout Candle -> Momentum -> HTF -> Session
#   -> Retest -> DXY -> News -> Entry
# EVERY threshold below is an input on purpose: these are starting values
# to back-test and tune, not fixed "correct" numbers.
USE_BREAKOUT_MOMENTUM=false

# 1) Important level. The pool is built from (strongest first): multi-touch
#    HTF Support/Resistance, Previous Day High/Low, Asian/London/NY session
#    High/Low, confirmed 15M Swing High/Low, and a configurable Opening
#    Range. Two sources within DEDUPE dollars of each other count as one
#    level (the stronger label wins).
BREAKOUT_SWING_LOOKBACK=3
BREAKOUT_SWING_MAX_COUNT=3
BREAKOUT_LEVEL_DEDUPE_DOLLARS=1.0
# The Opening Range level source's own UTC window (HH:MM, 24h) —
# independent of ORB's own opening-range window above.
BREAKOUT_OR_START_UTC=00:00
BREAKOUT_OR_END_UTC=01:00

# 2) Breakout candle: the WHOLE M5 candle (wick included) must clear the
#    level, its body must sit inside the ATR band, and its close must sit
#    deep on the breakout side of its own range.
BREAKOUT_MIN_BODY_ATR=0.6
BREAKOUT_MAX_BODY_ATR=2.5
BREAKOUT_CLOSE_LOCATION=0.70

# 3) Momentum: the breakout candle's range must expand against the average
#    range of the previous 14 candles.
BREAKOUT_MIN_RANGE_EXPANSION=1.2

# 4) Don't chase: reject the entry once its close sits more than this many
#    ATR past the level.
BREAKOUT_MAX_ENTRY_DISTANCE_ATR=0.8

# 5) Retest (default mode): Break -> Retest -> Entry. false = enter on the
#    breakout candle itself. LOOKBACK is how many M5 candles back the
#    retest sequence may reach; TOLERANCE is how close price must come back
#    to the level to count as retesting it.
BREAKOUT_REQUIRE_RETEST=true
BREAKOUT_RETEST_LOOKBACK=24
BREAKOUT_RETEST_TOLERANCE_DOLLARS=0.5

# 5b) Failed-Breakout Reversal — trade the TRAP instead of discarding it:
#     a strong break that gets rejected (price CLOSES back through the
#     level) and is then CONFIRMED by a further candle extending that
#     rejection becomes an entry in the OPPOSITE direction, with the stop
#     beyond the trap's own extreme. MAX_CANDLES is how long after the
#     break the failure may arrive and still count as a fakeout.
#     Off by default — measured on a real losing streak it turned 2 of 5
#     losses into clear wins, 2 into sub-target scratches and 1 into no
#     trade, so it is worth testing, not assuming.
BREAKOUT_FAILED_REVERSAL=false
BREAKOUT_FAILED_REVERSAL_MAX_CANDLES=12
#     The reversal's own don't-chase limit: the entry must stay within
#     this many ATR of the trap's extreme, which is what its stop hangs
#     off. (BREAKOUT_MAX_ENTRY_DISTANCE_ATR measures against the LEVEL,
#     which for a reversal is a different price entirely.) Worst-case
#     risk is therefore this + BREAKOUT_SL_ATR, by construction.
BREAKOUT_REVERSAL_MAX_TRAP_ATR=1.5

# 6) Session filter — no trade outside these UTC windows (HH:MM). Separate
#    from the other tiers' sessions because broker server time and DST
#    shift what "the session" means.
BREAKOUT_SESSION_FILTER=true
BREAKOUT_LONDON_START_UTC=07:00
BREAKOUT_LONDON_END_UTC=16:00
BREAKOUT_NEWYORK_START_UTC=12:00
BREAKOUT_NEWYORK_END_UTC=21:00
#    The Asian session is a separate, opt-in third window. Note the Asian
#    range already feeds this engine as a LEVEL source (Asian High/Low)
#    without trading inside it — turning this on means taking breakouts
#    during the thinnest liquidity of the gold day, so measure it before
#    keeping it. Every fired setup logs which session produced it.
BREAKOUT_ASIAN_SESSION=false
BREAKOUT_ASIAN_START_UTC=00:00
BREAKOUT_ASIAN_END_UTC=09:00

# 7+9) DXY and 1H-structure. block (default) = a CLEAR contradiction
#      rejects the setup, score = agreement only adds Confluence Score,
#      off = not consulted. Neither ever blocks on missing data: an
#      unreadable/flat DXY and an unclear 1H structure both count as
#      "no objection", so a dead feed cannot halt trading.
BREAKOUT_HTF_MODE=block
BREAKOUT_DXY_MODE=block

# 8) News filter: no NEW entry within this many minutes either side of a
#    high-impact USD release (CPI/NFP/FOMC/Rate/PCE). Open trades are never
#    touched.
BREAKOUT_NEWS_FILTER=true
BREAKOUT_NEWS_BLACKOUT_MINUTES=15

# 10) Risk: Stop Loss sits this many ATR beyond the broken LEVEL (structure
#     + volatility, never a fixed dollar distance); Take Profit is this R
#     multiple of the resulting risk. Test 1.5 / 2.0 / 2.5 / 3.0.
BREAKOUT_SL_ATR=1.2
# Defaults to the global Risk:Reward ratio (1.8) — every tier targets the
# same multiple. Override only for a deliberate A/B test.
BREAKOUT_TP_R=1.8

# --- Institutional Risk Management, Spread Filter & Trade Safety --------
# OFF by default: ENABLE_AUTO_TRADING=false means Aureus AI stays exactly
# what it always was, a signal-only advisor — no real broker order is ever
# sent. Set to "true" only once you've reviewed the bridge's /order/* code
# and are ready for it to open/modify REAL positions.
ENABLE_AUTO_TRADING=false
# Dynamic Position Sizing: max % of live account Equity risked per trade.
RISK_PERCENT_PER_TRADE=1.0
# XAUUSD contract size (oz/lot) — 100 is the standard broker contract.
XAU_CONTRACT_SIZE=100
MIN_LOT_SIZE=0.01
MAX_LOT_SIZE=5.0
LOT_STEP=0.01
# Live Spread Protection: reject a signal/order above this many pips
# ($0.10 = 1 pip on XAUUSD, so 30 pips = $3.00).
MAX_SPREAD_PIPS=30
# Break-Even: at 1:1 R:R, the FULL lot's Stop Loss moves to Entry (no
# partial close) — resolves to either exactly 0 or the original Take
# Profit. Nothing to configure here; no .env key needed.

# --- Ranging Market Module: Zone Bounce Protocol (zone_bounce_engine.dart)
# A sixth, fully independent tier — off by default. It is the MIRROR of the
# Strict Top-Down HTF Retest protocol: a clean rejection off a level that
# HOLDS, taken only while there is NO clear HTF bias (1H undefined, or 1H
# and 4H disagreeing). The Top-Down path cannot produce this setup by
# construction — it requires a decisive close THROUGH the level first and
# rejects a Pinbar as confirmation — which is why this is a separate engine
# rather than a loosening of that one.
ENABLE_RANGING_BOUNCE=false
# How close the rejection wick must come to the level to count as a touch.
ZONE_BOUNCE_TOUCH_DOLLARS=1.0
# Minimum rejection-wick share of the candle's range for the looser third
# shape (Pinbar and Engulfing reuse TaEngine's own definitions).
ZONE_BOUNCE_MIN_WICK_RATIO=0.5
# Candles back to check for a decisive close THROUGH the level. A level
# broken inside this window is a broken level, not a range boundary.
ZONE_BOUNCE_BREAK_LOOKBACK=10
# Stop Loss buffer beyond the rejection wick, in ATR(14) multiples.
ZONE_BOUNCE_SL_ATR=0.5
# Adaptive Target: the range's opposing boundary only CLIPS Take Profit when
# it lies at least this many R from Entry. A nearer boundary is ignored and
# TP stays at the global ratio (1:1.8). It never extends the target.
ZONE_BOUNCE_MIN_BOUNDARY_R=1.0
# A clipped target can land below the global ratio; below this floor the
# setup is rejected outright. (Sits above MIN_BOUNDARY_R on purpose: a
# boundary between the two clips a setup into a rejection.)
ZONE_BOUNCE_MIN_RR=1.2
# How many of the NEAREST zones are evaluated per cycle, ranked by TRUE
# distance (no higher-timeframe handicap) — the Multi-Zone Evaluation fix.
ZONE_BOUNCE_ZONE_COUNT=3

# --- One Active Trade Limit -------------------------------------------------
# true (default): while ANY trade is open no engine is evaluated at all.
# false: every engine keeps scanning, so positions can overlap. A 120-hour
# backtest showed this multiplies trade count ~3x by re-entering the same idea
# repeatedly (correlated exposure) and turned +700 pips into ~-24 pips. Leave
# it on for a live account.
ONE_ACTIVE_TRADE_LIMIT=true
